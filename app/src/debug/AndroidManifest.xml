<?xml version="1.0" encoding="utf-8"?>
<!-- The TV features are declared once, in the main manifest: lint only reads this file on its own. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher,MissingLeanbackSupport,ImpliedTouchscreenHardware">
    <application>
        <!-- Debug only: a page that shows the Compose theme and components, opened with adb. -->
        <activity
            android:name=".ui.compose.ComposeGalleryActivity"
            android:exported="true" />
        <activity
            android:name=".ui.compose.DebugLaunchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".ui.compose.ComposeHostDemoActivity"
            android:exported="false" />
        <receiver
            android:name=".ui.compose.SeedProgressReceiver"
            android:exported="true" />
    </application>
</manifest>
