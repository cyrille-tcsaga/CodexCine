<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Writes the app's own cards in the system "Play next" row. Granted at install, no prompt. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Installs its own updates from GitHub. Android still asks the viewer, once to allow it, then each time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".CodexCineApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodexCine"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".ui.browse.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CodexCine.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.details.DetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.grid.GridActivity"
            android:exported="false" />
        <activity
            android:name=".ui.season.SeasonActivity"
            android:exported="false" />
        <activity
            android:name=".ui.person.PersonActivity"
            android:exported="false" />
        <!--
            Exported for searches from outside: the system search and the Assistant ("cherche Dune sur
            Codex Ciné"). The query is cleaned and only ever searched (see SearchFragment).
        -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <!-- Titles for the system search. Only the system may read it. -->
        <provider
            android:name=".ui.search.SearchSuggestionProvider"
            android:authorities="dev.codexsoft.codexcine.search"
            android:exported="true"
            android:readPermission="android.permission.GLOBAL_SEARCH" />
        <activity
            android:name=".ui.playback.PlaybackActivity"
            android:exported="false" />
        <activity
            android:name=".ui.error.AboutActivity"
            android:exported="false" />

        <!--
            Opened by the system home screen's "Play next" row and the system search. Exported, so it only
            accepts codexcine://play and codexcine://details links it can check (see AppLink).
        -->
        <activity
            android:name=".ui.launch.PlayLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="codexcine" />
                <data android:host="play" />
                <data android:host="details" />
            </intent-filter>
        </activity>

        <!-- The installer's answer to an update. Not exported: only the system calls it, through a PendingIntent. -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />

        <!-- The system tells the app when the viewer removes one of its "Play next" cards. -->
        <receiver
            android:name=".data.watchnext.WatchNextRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
