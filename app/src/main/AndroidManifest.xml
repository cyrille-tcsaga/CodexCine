<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Writes the app's own cards in the system "Play next" row. Granted at install, no prompt. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".CodexCineApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodexCine"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".ui.browse.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CodexCine.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.details.DetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.grid.GridActivity"
            android:exported="false" />
        <activity
            android:name=".ui.season.SeasonActivity"
            android:exported="false" />
        <activity
            android:name=".ui.person.PersonActivity"
            android:exported="false" />
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false" />
        <activity
            android:name=".ui.playback.PlaybackActivity"
            android:exported="false" />
        <activity
            android:name=".ui.error.AboutActivity"
            android:exported="false" />

        <!--
            Opened by the system home screen's "Play next" row. Exported, so it only accepts
            codexcine://play links it can check (see PlayLink), and only hands over to the player.
        -->
        <activity
            android:name=".ui.launch.PlayLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:host="play"
                    android:scheme="codexcine" />
            </intent-filter>
        </activity>

        <!-- The system tells the app when the viewer removes one of its "Play next" cards. -->
        <receiver
            android:name=".data.watchnext.WatchNextRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
