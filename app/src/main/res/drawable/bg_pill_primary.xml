<?xml version="1.0" encoding="utf-8"?>
<!-- The main call to action: an amber pill that turns ivory with focus. Its text stays dark either way. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/brand_ivory" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/brand_amber" />
        </shape>
    </item>
</selector>
