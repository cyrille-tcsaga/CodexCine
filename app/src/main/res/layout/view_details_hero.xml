<?xml version="1.0" encoding="utf-8"?>
<!-- The top of the details screen. The artwork is the screen backdrop; this only lays text and buttons over it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:minHeight="@dimen/details_hero_height"
    android:orientation="vertical"
    android:paddingStart="@dimen/hero_padding_start"
    android:paddingEnd="48dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/details_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/brand_display"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/brand_amber"
        android:textFontWeight="700"
        android:textSize="16sp"
        tools:text="Film" />

    <TextView
        android:id="@+id/details_title"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/brand_display"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/brand_ivory"
        android:textFontWeight="700"
        android:textSize="52sp"
        tools:text="Titre du film" />

    <LinearLayout
        android:id="@+id/details_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/details_genres"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/brand_mist"
        android:textFontWeight="500"
        android:textSize="18sp"
        tools:text="Horreur · Science-Fiction · Aventure" />

    <TextView
        android:id="@+id/details_overview"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="4"
        android:textColor="@color/brand_ivory"
        android:textSize="18sp"
        tools:text="Résumé du film." />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <Button
            android:id="@+id/details_play"
            style="@style/CodexCine.HeroButton.Primary"
            android:text="@string/action_play" />

        <Button
            android:id="@+id/details_trailer"
            style="@style/CodexCine.HeroButton"
            android:layout_marginStart="16dp"
            android:drawableStart="@drawable/ic_trailer"
            android:text="@string/action_trailer"
            android:visibility="gone" />

        <Button
            android:id="@+id/details_my_list"
            style="@style/CodexCine.HeroButton"
            android:layout_marginStart="16dp"
            android:drawableStart="@drawable/ic_add"
            android:text="@string/action_my_list"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
