<?xml version="1.0" encoding="utf-8"?>
<!--
    The "Voir tout" grid's title bar: the filters button where Leanback puts its search orb (so focus
    reaches it by going up from the grid), what is filtered, and the screen title.
-->
<dev.codexsoft.codexcine.ui.grid.FilterTitleView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@id/browse_title_group"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/hero_padding_start"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/hero_padding_start"
    android:paddingBottom="8dp">

    <Button
        android:id="@+id/grid_filters"
        style="@style/CodexCine.HeroButton"
        android:layout_height="46dp"
        android:drawableStart="@drawable/ic_filter"
        android:text="@string/grid_filters"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/grid_filters_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/brand_mist"
        android:textSize="17sp"
        tools:text="Action · Années 1990 · ★ 7+" />

    <TextView
        android:id="@+id/grid_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/CodexCine.TextAppearance.Title"
        tools:text="Films populaires" />
</dev.codexsoft.codexcine.ui.grid.FilterTitleView>
