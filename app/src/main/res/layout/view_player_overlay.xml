<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- Everything stays inside the TV safe area: 48dp horizontally and 27dp vertically. -->
    <LinearLayout
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_top"
        android:baselineAligned="false"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="56dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/player_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/brand_display"
                android:textColor="@android:color/white"
                android:textFontWeight="700"
                android:textSize="26sp"
                tools:text="Titre" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/player_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
                    tools:text="2024 · S1 · E3 · Épisode" />

                <LinearLayout
                    android:id="@+id/player_language_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/player_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
            tools:text="22:47" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="56dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <TextView
            android:id="@+id/player_seek_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="invisible"
            tools:text="41:12"
            tools:visibility="visible" />

        <dev.codexsoft.codexcine.ui.playback.web.PlayerProgressView
            android:id="@+id/player_progress"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:nextFocusDown="@+id/player_button_play_pause" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/player_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
                tools:text="12:30" />

            <TextView
                android:id="@+id/player_end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
                tools:text="Fin à 22:47" />

            <TextView
                android:id="@+id/player_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
                tools:text="-1:30:00" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/player_button_rewind"
                style="@style/Widget.CodexCine.PlayerIconButton"
                android:contentDescription="@string/player_cd_rewind"
                android:nextFocusUp="@+id/player_progress"
                android:src="@drawable/ic_player_rewind" />

            <ImageButton
                android:id="@+id/player_button_play_pause"
                style="@style/Widget.CodexCine.PlayerIconButton"
                android:contentDescription="@string/player_cd_pause"
                android:nextFocusUp="@+id/player_progress"
                android:src="@drawable/ic_player_pause" />

            <ImageButton
                android:id="@+id/player_button_forward"
                style="@style/Widget.CodexCine.PlayerIconButton"
                android:contentDescription="@string/player_cd_forward"
                android:nextFocusUp="@+id/player_progress"
                android:src="@drawable/ic_player_forward" />

            <Button
                android:id="@+id/player_button_speed"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:layout_marginEnd="12dp"
                android:nextFocusUp="@+id/player_progress"
                android:textAllCaps="false"
                tools:text="1×" />

            <ImageButton
                android:id="@+id/player_button_mute"
                style="@style/Widget.CodexCine.PlayerIconButton"
                android:contentDescription="@string/player_cd_mute"
                android:nextFocusUp="@+id/player_progress"
                android:src="@drawable/ic_player_volume" />

            <ImageButton
                android:id="@+id/player_button_next"
                style="@style/Widget.CodexCine.PlayerIconButton"
                android:contentDescription="@string/player_cd_next"
                android:nextFocusUp="@+id/player_progress"
                android:src="@drawable/ic_player_next"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/player_button_reload"
                style="@style/Widget.CodexCine.PlayerIconButton"
                android:contentDescription="@string/player_cd_reload"
                android:nextFocusUp="@+id/player_progress"
                android:src="@drawable/ic_player_reload" />

            <ImageButton
                android:id="@+id/player_button_quit"
                style="@style/Widget.CodexCine.PlayerIconButton"
                android:contentDescription="@string/player_cd_quit"
                android:nextFocusUp="@+id/player_progress"
                android:src="@drawable/ic_player_close" />

            <!-- Icons alone say little at three metres: this names the focused control. -->
            <TextView
                android:id="@+id/player_focus_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="72dp"
            android:layout_height="72dp" />

        <TextView
            android:id="@+id/player_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="4"
            android:text="@string/player_loading"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/player_loading_provider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="@android:color/black"
            android:shadowRadius="4"
            android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
            tools:text="Vidzy" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_panel"
        android:gravity="center"
        android:minWidth="160dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/player_feedback_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/player_feedback_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/player_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_player_panel"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
        android:visibility="gone"
        tools:text="Connexion lente…" />

    <LinearLayout
        android:id="@+id/player_panel_speed"
        style="@style/Widget.CodexCine.PlayerPanel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/player_speed_title"
            android:textAppearance="@style/TextAppearance.CodexCine.PlayerPanelTitle" />

        <LinearLayout
            android:id="@+id/player_speed_options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_panel_exit"
        style="@style/Widget.CodexCine.PlayerPanel">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/player_exit_title"
            android:textAppearance="@style/TextAppearance.CodexCine.PlayerPanelTitle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/player_exit_continue"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:layout_marginEnd="12dp"
                android:text="@string/player_continue"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/player_exit_quit"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:text="@string/player_quit"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_panel_resume"
        style="@style/Widget.CodexCine.PlayerPanel">

        <TextView
            android:id="@+id/player_resume_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textAppearance="@style/TextAppearance.CodexCine.PlayerPanelTitle"
            tools:text="Reprendre à 23:14 ?" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/player_resume_yes"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:layout_marginEnd="12dp"
                android:text="@string/player_resume"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/player_resume_no"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:text="@string/player_from_start"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_panel_next"
        style="@style/Widget.CodexCine.PlayerPanel"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="27dp"
        android:gravity="start">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp">

                <ProgressBar
                    android:id="@+id/player_next_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="5"
                    android:progressDrawable="@drawable/ring_player_countdown" />

                <TextView
                    android:id="@+id/player_next_seconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
                    tools:text="10" />
            </FrameLayout>

            <TextView
                android:id="@+id/player_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="480dp"
                android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
                tools:text="Épisode suivant : S1 · E4 · Titre" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/player_next_now"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:layout_marginEnd="12dp"
                android:text="@string/player_play_now"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/player_next_cancel"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:text="@string/player_cancel"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_panel_error"
        style="@style/Widget.CodexCine.PlayerPanel">

        <TextView
            android:id="@+id/player_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="@style/TextAppearance.CodexCine.PlayerPanelTitle"
            tools:text="Titre" />

        <TextView
            android:id="@+id/player_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:maxWidth="640dp"
            android:textAppearance="@style/TextAppearance.CodexCine.PlayerBody"
            tools:text="La source ne répond pas." />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/player_error_retry"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:layout_marginEnd="12dp"
                android:text="@string/retry"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/player_error_back"
                style="@style/Widget.CodexCine.PlayerTextButton"
                android:text="@string/back"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</merge>
