<?xml version="1.0" encoding="utf-8"?>
<!-- One sidebar entry. Leanback focuses a wrapper around it, hence duplicateParentState. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sidebar_item"
    android:duplicateParentState="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/sidebar_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/sidebar_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:duplicateParentState="true"
        android:fontFamily="@font/brand_display"
        android:textColor="@color/on_pill"
        android:textFontWeight="700"
        android:textSize="20sp"
        tools:text="Accueil" />
</LinearLayout>
