<resources>

    <style name="Theme.CodexCine" parent="@style/Theme.Leanback">
        <item name="android:windowBackground">@drawable/default_background</item>
        <item name="android:colorAccent">@color/brand_amber</item>
        <item name="android:fontFamily">@font/brand_text</item>
        <item name="android:textViewStyle">@style/CodexCine.TextView</item>
        <item name="browseTitleTextStyle">@style/CodexCine.Title.Text</item>
        <item name="headerStyle">@style/CodexCine.Header</item>
        <item name="rowHeaderStyle">@style/CodexCine.Row.Header</item>
        <item name="imageCardViewTitleStyle">@style/CodexCine.Card.Title</item>
        <item name="imageCardViewContentStyle">@style/CodexCine.Card.Content</item>
        <item name="errorMessageStyle">@style/CodexCine.ErrorMessage</item>
    </style>

    <!-- Shown by the system while the app starts, then replaced by Theme.CodexCine. -->
    <style name="Theme.CodexCine.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CodexCine</item>
    </style>
</resources>
